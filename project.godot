; 天山牧歌 / Tianshan Pastorale
; Engine configuration file.
; 格式与版本号参照 godotengine/godot-demo-projects (config_version=5, features 4.7)。
; 输入映射不写在这里 —— 由 res://client/input_actions.gd 用 KEY_* 枚举在启动时注册，
; 避免硬编码 keycode 数字在引擎版本间漂移。

config_version=5

[application]

config/name="天山牧歌"
config/description="多人草原模拟经营 · 真实新疆地形"
config/tags=PackedStringArray("3d", "simulation", "xinjiang")
run/main_scene="res://client/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GeoRef="*res://shared/sim/georef.gd"
TerrainDB="*res://client/world/terrain_db.gd"
InputActions="*res://client/input_actions.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.047, 0.066, 0.058, 1)
